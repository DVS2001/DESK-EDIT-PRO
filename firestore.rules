rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Personal Cloud Media Assets Collection
      match /mediaAssets/{assetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(assetId) && request.resource.data.ownerId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(assetId);
      }
    }

    // Video Projects Collection
    match /projects/{projectId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(projectId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(projectId) && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && isValidId(projectId) && resource.data.ownerId == request.auth.uid;
    }
  }
}
